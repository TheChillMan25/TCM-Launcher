<Application x:Class="TCM_Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TCM_Launcher"
             xmlns:vmUc="clr-namespace:TCM_Launcher.ViewModel.UserControls"
             xmlns:vmUcS="clr-namespace:TCM_Launcher.ViewModel.UserControls.Sidebars"
             xmlns:vmUcP="clr-namespace:TCM_Launcher.ViewModel.UserControls.Panels"
             xmlns:vmUcCI="clr-namespace:TCM_Launcher.ViewModel.UserControls.ControlItems"
             xmlns:uc="clr-namespace:TCM_Launcher.View.UserControls"
             xmlns:ucCI="clr-namespace:TCM_Launcher.View.UserControls.ControlItems"
             xmlns:ucS="clr-namespace:TCM_Launcher.View.UserControls.Sidebars"
             xmlns:ucP="clr-namespace:TCM_Launcher.View.UserControls.Panels">
    <Application.Resources>
        <ResourceDictionary>
            
            <!--Styles-->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/SideBarStyles.xaml"/>
                <ResourceDictionary Source="Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="Styles/InputStyles.xaml"/>
                <ResourceDictionary Source="Styles/ContextMenuStyles.xaml"/>
                <ResourceDictionary Source="Styles/Icons.xaml"/>
                <ResourceDictionary Source="Styles/TooltipStyles.xaml"/>
                <ResourceDictionary Source="Styles/TextStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--UserControls-->
            <DataTemplate DataType="{x:Type vmUc:ProfilesViewModel}">
                <uc:ProfilesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmUc:ProfileDetailsViewModel}">
                <uc:ProfileDetailsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmUc:AddContentViewModel}">
                <uc:AddContentView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmUc:SearchedModDetailsViewModel}">
                <uc:SearchedModDetailsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmUc:AppSettingsViewModel}">
                <uc:AppSettingsView />
            </DataTemplate>

            <!--ControlItems-->
            <DataTemplate DataType="{x:Type vmUcCI:ServerCardViewModel}">
                <ucCI:ServerCardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmUcCI:ModSearchResultCardViewModel}">
                <ucCI:ModSearchResultCardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmUcCI:ModVersionCardViewModel}">
                <ucCI:ModVersionCardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmUcCI:ProfileModViewModel}">
                <ucCI:ProfileModView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmUcCI:PinnedProfileViewModel}">
                <ucCI:PinnedProfileView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmUcCI:ProfileInstallIndicatorViewModel}">
                <ucCI:ProfileInstallIndicatiorView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmUcCI:FriendSearchItemViewModel}">
                <ucCI:FriendSearchItemView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmUcCI:NotificationViewModel}">
                <ucCI:NotificationView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmUcCI:FriendViewModel}">
                <ucCI:FriendView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmUcCI:ModpackViewModel}">
                <ucCI:ModpackView/>
            </DataTemplate>

            <!--Sidebars-->
            <DataTemplate DataType="{x:Type vmUcS:LeftSidebarViewModel}">
                <ucS:LeftSidebarView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmUcS:RightSidebarViewModel}">
                <ucS:RightSidebarView />
            </DataTemplate>
            
            <!--Floating panels-->
            <DataTemplate DataType="{x:Type vmUcP:SearchFriendsViewModel}">
                <ucP:AddFriendView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmUcP:AddServerViewModel}">
                <ucP:AddServerView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmUcP:ExportModpackViewModel}">
                <ucP:ExportModpackView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmUcP:ModDetailsViewModel}">
                <ucP:ModDetailsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmUcP:NewProfileViewModel}">
                <ucP:NewProfileView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmUcP:NotificationsViewModel}">
                <ucP:NotificationsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmUcP:ProfileSettingsViewModel}">
                <ucP:ProfileSettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmUcP:ModpacksViewModel}">
                <ucP:ModpacksView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmUcP:PopupViewModel}">
                <ucP:PopupView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmUcP:LoadingScreenViewModel}">
            <ucP:LoadingScreenView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
