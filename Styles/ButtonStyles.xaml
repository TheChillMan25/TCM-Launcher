<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="FocusVisual" TargetType="Control">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="2" StrokeDashArray="1 2" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" SnapsToDevicePixels="true" StrokeThickness="1"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <SolidColorBrush x:Key="RoundButton.Static.Background" Color="#333"/>
    <SolidColorBrush x:Key="RoundButton.Static.Foreground" Color="#f2c480"/>
    <SolidColorBrush x:Key="RoundButton.Static.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="RoundButton.MouseOver.Background" Color="#444"/>
    <SolidColorBrush x:Key="RoundButton.MouseOver.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="RoundButton.Pressed.Background" Color="#222"/>
    <SolidColorBrush x:Key="RoundButton.Pressed.Foreground" Color="#f2c480"/>
    <SolidColorBrush x:Key="RoundButton.Pressed.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="RoundButton.Disabled.Background" Color="#333"/>
    <SolidColorBrush x:Key="RoundButton.Disabled.Border" Color="#FFADB2B5"/>
    <SolidColorBrush x:Key="RoundButton.Disabled.Foreground" Color="#f2c480"/>
    
    <Style x:Key="RoundButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Background" Value="{StaticResource RoundButton.Static.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RoundButton.Static.Border}"/>
        <Setter Property="Foreground" Value="{StaticResource RoundButton.Static.Foreground}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="Width" Value="50"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontFamily" Value="Calibri"/>
        <Setter Property="FontWeight" Value="Heavy"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="50" SnapsToDevicePixels="true">
                        <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Button.IsDefaulted" Value="true">
                            <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" TargetName="border" Value="{StaticResource RoundButton.MouseOver.Background}"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource RoundButton.MouseOver.Border}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter Property="Background" TargetName="border" Value="{StaticResource RoundButton.Pressed.Background}"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource RoundButton.Pressed.Border}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Opacity" TargetName="border" Value="0.5"/>
                            <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource RoundButton.Disabled.Foreground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <Style TargetType="Path">
                <Setter Property="Height" Value="25"/>
                <Setter Property="Width" Value="25"/>
            </Style>
        </Style.Resources>
    </Style>
        
    <SolidColorBrush x:Key="ButtonWithIcon.Static.Background" Color="#f2c480"/>
    <SolidColorBrush x:Key="ButtonWithIcon.Static.Foreground" Color="#333"/>
    <SolidColorBrush x:Key="ButtonWithIcon.Static.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="ButtonWithIcon.MouseOver.Background" Color="#e0b16c"/>
    <SolidColorBrush x:Key="ButtonWithIcon.MouseOver.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="ButtonWithIcon.Pressed.Background" Color="#FFC4E5F6"/>
    <SolidColorBrush x:Key="ButtonWithIcon.Pressed.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="ButtonWithIcon.Disabled.Background" Color="#FFF4F4F4"/>
    <SolidColorBrush x:Key="ButtonWithIcon.Disabled.Border" Color="#FFADB2B5"/>
    <SolidColorBrush x:Key="ButtonWithIcon.Disabled.Foreground" Color="#FF838383"/>
        
    <Style x:Key="ButtonWithIcon" TargetType="{x:Type Button}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Background" Value="{StaticResource ButtonWithIcon.Static.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ButtonWithIcon.Static.Border}"/>
        <Setter Property="Foreground" Value="{StaticResource ButtonWithIcon.Static.Foreground}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="Padding" Value="15 0"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontFamily" Value="Calibri"/>
        <Setter Property="FontWeight" Value="Heavy"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="true" CornerRadius="10">
                        <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefaulted" Value="true">
                            <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" TargetName="border" Value="{StaticResource ButtonWithIcon.MouseOver.Background}"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource ButtonWithIcon.MouseOver.Border}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter Property="Background" TargetName="border" Value="{StaticResource ButtonWithIcon.Pressed.Background}"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource ButtonWithIcon.Pressed.Border}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Background" TargetName="border" Value="{StaticResource ButtonWithIcon.Disabled.Background}"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource ButtonWithIcon.Disabled.Border}"/>
                            <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource ButtonWithIcon.Disabled.Foreground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>