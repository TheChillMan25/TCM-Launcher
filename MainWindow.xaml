<Window x:Class="TCM_Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TCM_Launcher"
        xmlns:userControls="clr-namespace:TCM_Launcher.View.UserControls"
        mc:Ignorable="d"
        Title="TCM Launcher" 
        MinHeight="450"
        MinWidth="800"
        Height="450"
        Width="800"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        WindowStyle="None"
        Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="15" CaptionHeight="0"/>
    </WindowChrome.WindowChrome>
    <Grid Background="#171717">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Name="HeaderBar" Grid.ColumnSpan="2" MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown" Background="Transparent" Margin="10 5 10 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Content="TCM Launcher" VerticalAlignment="Center" Foreground="#f2c480" FontFamily="Calibri" FontSize="24"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="MinimizeButton"
                    Width="30"
                    Height="30"
                    Style="{StaticResource RoundButton}" Click="MinimizeButton_Click">
                    <Path   Data="{StaticResource MinimizeIcon}"
                            Fill="#f2c480"
                            Width="15"
                            Height="15"
                            Stretch="Uniform"/>
                </Button>
                <Button Name="MaximizeButton"
                        Width="30"
                        Height="30"
                        Style="{StaticResource RoundButton}" Click="MaximizeButton_Click">
                    <Path   Data="{StaticResource MaximizeIcon}"
                            Fill="#f2c480"
                            Width="15"
                            Height="15"
                            Stretch="Uniform"/>
                </Button>
                <Button Name="CloseButton"    
                        Width="30"
                        Height="30"
                        Style="{StaticResource RoundButton}" Click="CloseButton_Click">
                    <Path   Data="{StaticResource CloseIcon}"
                        Fill="#f2c480"
                        Width="15"
                        Height="15"
                        Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Grid>
        <StackPanel Name="SideBar" Grid.Row="2">
            <Button Name="AddProfileButton"
                Style="{StaticResource RoundButton}"
                Click="AddProfileButton_Click"
                Background="Transparent"
                IsEnabled="{Binding IsVersionsLoaded}">
                <Path   Data="{StaticResource AddIcon}"
                    Fill="#f2c480"
                    Width="20"
                    Height="20"
                    Stretch="Uniform"/>
            </Button>
            <TextBlock Text="Checking versions..."
                       HorizontalAlignment="Center"
                       Foreground="#f5f5f5"
                       FontSize="10"
                       Visibility="{Binding IsVersionsLoading, Converter={StaticResource BoolToVis}}"/>
            <ListBox    ItemsSource="{Binding GameProfiles}"
                        SelectedItem="{Binding SelectedGameProfile, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                        Background="Transparent" 
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource SideBarListBoxItemStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Path   Data="{StaticResource ProfileIcon}"
                                Fill="#f2c480"
                                Width="25"
                                Height="25"
                                Stretch="Uniform"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button x:Name="UpdateButton" 
                Visibility="{Binding AvailableUpdate.CanUpdate,
                            Converter={StaticResource BoolToVis}}"
                Background="Transparent"
                Style="{StaticResource RoundButton}"
                Click="UpdateButton_Click">
                <Path   Data="{StaticResource DownloadIcon}"
                                Fill="#f2c480"
                                Width="25"
                                Height="25"
                                Stretch="Uniform"/>

            </Button>

        </StackPanel>
        <Border Name="MainViewBorder"
                Grid.Column="1" 
                Grid.Row="2" 
                Background="#222" 
                BorderBrush="#666" 
                BorderThickness="1,1,0,0"
                CornerRadius="25,0,0,0">
            <userControls:ProfileDetailsView SelectedGameProfile="{Binding SelectedGameProfile}"
                                             DownloadProgress="{Binding DownloadProgress}"
                                             DeleteRequested="DeleteProfileEventHandler" 
                                             Visibility="{Binding HasSelectedProfile, 
                                                        Converter={StaticResource BoolToVis}}"/>
        </Border>
        <Border Name="WindowBorder"
                Grid.Row="0" Grid.RowSpan="3" 
                Grid.Column="0" Grid.ColumnSpan="2" 
                BorderBrush="#444" 
                BorderThickness="1" 
                CornerRadius="9" 
                IsHitTestVisible="False"/>
    </Grid>
</Window>
