<Window x:Class="TCM_Launcher.View.Windows.AddServerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TCM_Launcher.View.Windows"
        mc:Ignorable="d"
        Title="{Binding WindowTitle,
    FallbackValue='Add server',
    TargetNullValue='Add server'}"
        Height="350" 
        Width="400"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0"
                      CaptionHeight="0"
                      CornerRadius="15"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="WhiteSmoke"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="WhiteSmoke"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
    </Window.Resources>
    <Grid Background="#171717">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="2"
                Grid.RowSpan="6"
                BorderBrush="#666"
                BorderThickness="1" 
                CornerRadius="9">
        </Border>
        <Button Name="CloseButton"    
            Width="30"
            Grid.Column="1"
            HorizontalAlignment="Right"
            Height="30"
            Style="{StaticResource RoundButton}" Click="CloseButton_Click">
            <Path Data="{StaticResource CloseIcon}"
                Fill="#f2c480"
                Width="15"
                Height="15"
                Stretch="Uniform"/>
        </Button>
        <Label Content="{Binding WindowTitle,
            FallbackValue='Add server',
            TargetNullValue='Add server'}"
               Style="{StaticResource WindowTitle}"/>
        <TextBlock Text="Server name"
               Grid.Row="1"/>
        <TextBlock Text="Server IP/Domain"
               Grid.Row="2"/>
        <TextBlock Text="Minecraft version"
               Grid.Row="3"/>
        <TextBlock Text="Bind profile"
               Grid.Row="4"/>
        <TextBox Style="{StaticResource DarkTextBox}" x:Name="ServerNameInput"
             Text="{Binding ServerName,
                UpdateSourceTrigger=PropertyChanged,
                Mode=TwoWay}"
             Grid.Row="1"
             Grid.Column="1"
             VerticalAlignment="Center"
             MaxLength="30" 
             FontSize="16"
             Margin="5"/>
        <TextBox Style="{StaticResource DarkTextBox}" x:Name="ServerIPInput"
                 Text="{Binding ServerAddress,
                UpdateSourceTrigger=PropertyChanged,
                Mode=TwoWay}"
                 Grid.Row="2"
                 Grid.Column="1"
                 VerticalAlignment="Center"
                 MaxLength="50" 
                 FontSize="16"
                 Margin="5" 
                 TextChanged="ServerIPInput_TextChanged"/>
        <ComboBox x:Name="MCVersionCombo"
              ItemsSource="{Binding MCVersions}"
              SelectedItem="{Binding ServerVersion,
                UpdateSourceTrigger=PropertyChanged,
                Mode=TwoWay}"
              Grid.Column="1"
              Grid.Row="3" 
              FontSize="16"
              Margin="5" SelectionChanged="MCVersionCombo_SelectionChanged"/>
        <Grid
            Grid.Column="1"
            Grid.Row="4" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ProfileCombo"
                      ItemsSource="{Binding Profiles}"
                      SelectedItem="{Binding BindedProfile,
                        UpdateSourceTrigger=PropertyChanged,
                        Mode=TwoWay}"
                      DisplayMemberPath="ProfileName"
                      IsEnabled="{Binding HasProfiles}"
                      FontSize="16"
                      Margin="5"/>
            <Button x:Name="ResetProfile"
                    Style="{StaticResource RoundButton}"
                    Height="30"
                    Width="30"
                    Grid.Column="1" Click="ResetProfile_Click">
                <Path Data="{StaticResource UnBindIcon}"
                      Fill="#f2c480"
                      Width="15"
                      Height="15"
                      Stretch="Uniform"/>
            </Button>
        </Grid>
        <Button x:Name="AddServerButton"
                Content="{Binding ButtonText,
            FallbackValue='Add server',
            TargetNullValue='Add server'}"
                Style="{StaticResource ButtonWithIcon}"
                Margin="10"
                HorizontalAlignment="Center"
                Grid.ColumnSpan="2"
                Grid.Row="5"
                Click="AddServerButton_Click">
        </Button>
    </Grid>
</Window>
