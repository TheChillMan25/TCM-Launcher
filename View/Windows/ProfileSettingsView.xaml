<Window x:Class="TCM_Launcher.View.Windows.ProfileSettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TCM_Launcher.View.Windows"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:userControls="clr-namespace:TCM_Launcher.View.UserControls"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="250" Width="400" ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#f5f5f5"/>
        </Style>
        
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="15" CaptionHeight="0"/>
    </WindowChrome.WindowChrome>
    <Grid Background="#252525">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="2" Grid.RowSpan="5" BorderBrush="#666" BorderThickness="1" CornerRadius="8"/>
        <Label Grid.Row="0" Grid.ColumnSpan="3" VerticalAlignment="Center" FontSize="24" Content="Settings" Margin="5 0 0 0" Foreground="#f2c480"/>
        <Button Name="CloseButton"    
                Width="30"
                Height="30"
                Grid.Column="3"
                HorizontalAlignment="Right"
                Margin="0 0 5 0"
                Style="{StaticResource RoundButton}" Click="CloseButton_Click">
            <Path   Data="{StaticResource CloseIcon}"
                    Fill="#f2c480"
                    Width="15"
                    Height="15"
                    Stretch="Uniform"/>
        </Button>
        <Label Content="Profile name" Grid.Row="1" FontSize="16" VerticalAlignment="Center"/>
        <Label Content="Memory" Grid.Row="2" FontSize="16" VerticalAlignment="Center"/>
        <Label Content="JVM Arguments" Grid.Row="3" FontSize="16" VerticalAlignment="Top"/>
        <TextBox Name="ProfileNameInput" Grid.Row="1" Text="{Binding GameProfile.ProfileName}" Grid.Column="1"/>
        <Grid Grid.Column="1" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Slider Template="{StaticResource Slider}" Name="RamSlider" 
                    Width="150" 
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Minimum="2048" 
                    Maximum="16384" 
                    TickFrequency="512" 
                    IsSnapToTickEnabled="True"
                    Value="{Binding MaxRam, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Width="60"
                     Grid.Column="1"
                     Margin="10,0,0,0" 
                     VerticalAlignment="Center"
                     Text="{Binding MaxRam, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
        <TextBox Name="JVMArgInput" Grid.Column="1" Grid.Row="3" Text="{Binding JVMArgs, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
        <Button Name="SaveButton" Grid.ColumnSpan="2" Grid.Row="4" HorizontalAlignment="Center" Style="{StaticResource ButtonWithIcon}" Margin="5" Click="SaveButton_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Path Data="{StaticResource SaveIcon}"
                                  Fill="#333"
                                  Width="15"
                                  Height="15"
                                  Margin="0 0 5 0"
                                  Stretch="Uniform"/>
                <TextBlock Text="Save" Grid.Column="1" VerticalAlignment="Center"/>
            </Grid>
        </Button>
    </Grid>
</Window>