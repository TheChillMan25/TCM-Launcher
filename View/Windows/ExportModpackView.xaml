<Window x:Class="TCM_Launcher.View.Windows.ExportModpackView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TCM_Launcher.View.Windows"
        xmlns:ucMisc="clr-namespace:TCM_Launcher.View.UserControls.Misc"
        mc:Ignorable="d"
        Title="Export modpack" 
        Height="550" 
        Width="800"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" 
                      CornerRadius="15" 
                      CaptionHeight="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="WhiteSmoke"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Background="#171717">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.ColumnSpan="2"
                Grid.RowSpan="5"
                BorderBrush="#666" 
                BorderThickness="1" 
                CornerRadius="8"/>
        <Grid Name="Header">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Style="{StaticResource WindowTitle}"
                   Content="Export modpack"/>
            <Button x:Name="CloseButton"
                    Style="{StaticResource RoundButton}"
                    Width="30"
                    Height="30"
                    Grid.Column="1" Click="CloseButton_Click">
                <Path Data="{StaticResource CloseIcon}"
                    Fill="#f2c480"
                    Width="15"
                    Height="15"
                    Stretch="Uniform"/>
            </Button>
        </Grid>
        <StackPanel Orientation="Horizontal"
                    Grid.Row="1"
                    Margin="5"
                    VerticalAlignment="Center">
            <TextBlock Text="Exporting:"/>
            <TextBlock Text="JAR files" Margin="10"/>
            <CheckBox Style="{StaticResource DarkCheckbox}"
                      IsChecked="{Binding ExportJARFiles}"
                      VerticalAlignment="Center"
                      Height="30"
                      Width="30"/>
            <TextBlock Text="Only imported" 
                       Margin="10"
                       IsEnabled="{Binding ExportJARFiles}"/>
            <CheckBox Style="{StaticResource DarkCheckbox}"
                      IsChecked="{Binding ExportOnlyImportedFiles}"
                      IsEnabled="{Binding ExportJARFiles}"
                      VerticalAlignment="Center"
                      Height="30"
                      Width="30">

                <CheckBox.ToolTip>
                    <ucMisc:CustomTooltip 
                        TooltipLabelText="Export only imported" 
                        TooltipContentText="Export only the .jar files of mods that were imported or have no third party download support."/>
                </CheckBox.ToolTip>
            </CheckBox>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Select all"/>
            <CheckBox Style="{StaticResource DarkCheckbox}"
                      IsChecked="True"
                      Width="30"
                      Height="30"
                      Grid.Column="1"
                      Margin="5"
                      Click="SelectAll_Clicked"/>
        </Grid>
        <ListBox ItemsSource="{Binding ExportableMods}"
                 Grid.Row="3"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource DarkCheckbox}"
                                  Width="30"
                                  Height="30"
                                  Margin="10"
                                  IsChecked="{Binding Mod.IsEnabled}"
                                  Click="ToggleModExport_Click"/>
                        <Image Source="{Binding Mod.IconUrl,
                        FallbackValue='pack://application:,,,/Assets/mc_img.png', 
                        TargetNullValue='pack://application:,,,/Assets/mc_img.png'}"
                               Width="40"
                               Height="40"
                               Grid.Column="1"/>
                        <TextBlock Text="{Binding Mod.Name,
                            FallbackValue='Mod name',
                            TargetNullValue='Mod name'}"
                                   Grid.Column="2"
                                   Margin="10"
                                   Foreground="WhiteSmoke"
                                   FontSize="20"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Style="{StaticResource ButtonWithIcon}"
                Grid.Row="4"
                Margin="5"
                HorizontalAlignment="Center"
                Width="Auto" Click="Button_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Path Data="{StaticResource ExportIcon}"
                      Fill="#333"
                      Width="25"
                      Height="25"
                      Stretch="Uniform"/>
                <TextBlock Text="Export"
                           Foreground="#333"
                           Grid.Column="1"/>
            </Grid>
        </Button>
    </Grid>
</Window>
