<UserControl x:Class="TCM_Launcher.View.UserControls.Tooltip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TCM_Launcher.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="60"  Width="250">
    <Border Background="#222"
            BorderBrush="#333" 
                BorderThickness="2" 
                CornerRadius="5"
                Padding="10"
                Grid.RowSpan="2">
        <StackPanel>
            <Label x:Name="TooltipLabel"
                       Foreground="#f2c480"
                       FontSize="20" 
                       FontFamily="Calibri"/>
            <TextBlock x:Name="TooltipTextBox" 
                           Foreground="WhiteSmoke" 
                           FontSize="15"
                           FontFamily="Calibri"
                           Grid.Row="1"
                           TextWrapping="Wrap"/>

        </StackPanel>
    </Border>
</UserControl>
