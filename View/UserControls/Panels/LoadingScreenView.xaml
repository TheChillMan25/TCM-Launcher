<UserControl x:Class="TCM_Launcher.View.UserControls.Panels.LoadingScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TCM_Launcher.View.UserControls.Panels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="#141414">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding Status,
                FallbackValue='Status',
                TargetNullValue='Status',
                UpdateSourceTrigger=PropertyChanged}"
                       FontSize="28"
                       Foreground="#f2c480"
                       FontFamily="Calibri"
                       VerticalAlignment="Bottom"
                       HorizontalAlignment="Center"
                       Margin="10"/>
            <ProgressBar Value="{Binding Progress}"
                         VerticalAlignment="Top"
                         HorizontalAlignment="Center"
                         Height="10"
                         Width="400"
                         Grid.Row="1"
                         Background="#333"
                         Foreground="#f2c480"
                         BorderThickness="0"
                         Maximum="100"
                         Minimum="0"
                         Margin="10"/>
        </Grid>
    </Border>
</UserControl>
