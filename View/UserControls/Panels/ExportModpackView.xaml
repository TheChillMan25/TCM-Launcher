<UserControl x:Class="TCM_Launcher.View.UserControls.Panels.ExportModpackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:TCM_Launcher.View.UserControls"
             xmlns:ucMisc="clr-namespace:TCM_Launcher.View.UserControls.Misc"
             Height="550" 
             Width="800"
             VerticalAlignment="Center"
             HorizontalAlignment="Center">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="WhiteSmoke"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>
    <Grid Background="#171717">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.ColumnSpan="2"
                Grid.RowSpan="5"
                BorderBrush="#666" 
                BorderThickness="1" 
                CornerRadius="8"/>
        <Grid Name="Header">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Style="{StaticResource WindowTitle}"
                   Content="Export modpack"/>
            <Button x:Name="CloseButton"
                    Style="{StaticResource RoundButton}"
                    Width="30"
                    Height="30"
                    Grid.Column="1" Click="CloseButton_Click">
                <Path Data="{StaticResource CloseIcon}"
                    Fill="#f2c480"
                    Width="15"
                    Height="15"
                    Stretch="Uniform"/>
            </Button>
        </Grid>
        <StackPanel Orientation="Horizontal"
                    Grid.Row="1"
                    Margin="5"
                    VerticalAlignment="Center">
            <TextBlock Text="Exporting:"/>
            <TextBlock Text="JAR files" Margin="10"/>
            <CheckBox Style="{StaticResource DarkCheckbox}"
                      IsChecked="{Binding ExportJARFiles}"
                      VerticalAlignment="Center"
                      Height="30"
                      Width="30"/>
            <TextBlock Text="Only imported" 
                       Margin="10"
                       IsEnabled="{Binding ExportJARFiles}"/>
            <CheckBox Style="{StaticResource DarkCheckbox}"
                      IsChecked="{Binding ExportOnlyImportedFiles}"
                      IsEnabled="{Binding ExportJARFiles}"
                      VerticalAlignment="Center"
                      Height="30"
                      Width="30">

                <CheckBox.ToolTip>
                    <ucMisc:CustomTooltip 
                        TooltipLabelText="Export only imported" 
                        TooltipContentText="Export only the .jar files of mods that were imported or have no third party download support."/>
                </CheckBox.ToolTip>
            </CheckBox>
            <TextBlock Text="Share with friends" 
                       Margin="10"/>
            <CheckBox Style="{StaticResource DarkCheckbox}"
                      IsChecked="{Binding ShareWithFriends}"
                      VerticalAlignment="Center"
                      Height="30"
                      Width="30"/>
            <Button x:Name="ShowSharePanel"
                    Style="{StaticResource RoundButton}"
                    Visibility="{Binding ShareWithFriends,
                FallbackValue=Visible,
                TargetNullValue=Visible,
                UpdateSourceTrigger=PropertyChanged,
                Converter={StaticResource BoolToVisConverter}}"
                    Height="30"
                    Width="30"
                    Click="ShowSharePanel_Click">
                <Path Data="{StaticResource EyeIcon}"
                      Fill="#f2c480"
                      Width="15"
                      Height="15"
                      Stretch="Uniform"/>
            </Button>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Select all"/>
            <CheckBox Style="{StaticResource DarkCheckbox}"
                      IsChecked="True"
                      Width="30"
                      Height="30"
                      Grid.Column="1"
                      Margin="5"
                      Click="SelectAll_Clicked"/>
        </Grid>
        <ListBox ItemsSource="{Binding ExportableMods}"
                 Grid.Row="3"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource DarkCheckbox}"
                                  Width="30"
                                  Height="30"
                                  Margin="10"
                                  IsChecked="{Binding Mod.IsEnabled}"
                                  Click="ToggleModExport_Click"/>
                        <Image Source="{Binding Mod.IconUrl,
                        FallbackValue='pack://application:,,,/Assets/mc_img.png', 
                        TargetNullValue='pack://application:,,,/Assets/mc_img.png'}"
                               Width="40"
                               Height="40"
                               Grid.Column="1"/>
                        <TextBlock Text="{Binding Mod.Name,
                            FallbackValue='Mod name',
                            TargetNullValue='Mod name'}"
                                   Grid.Column="2"
                                   Margin="10"
                                   Foreground="WhiteSmoke"
                                   FontSize="20"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name="ExportButton"
                Style="{StaticResource ButtonWithIcon}"
                Grid.Row="4"
                Margin="5"
                HorizontalAlignment="Center"
                Width="Auto" Click="Button_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Path Data="{StaticResource ExportIcon}"
                      Fill="#333"
                      Width="25"
                      Height="25"
                      Stretch="Uniform"/>
                <TextBlock Text="{Binding ButtonText,
                    FallbackValue='Export',
                    TargetNullValue='Export'}"
                           Foreground="#333"
                           Grid.Column="1"/>
            </Grid>
        </Button>
        <Border Name="ShareWithFriendsPanel"
                Visibility="{Binding SharePanelVisible,
            FallbackValue=Hidden,
            TargetNullValue=Hidden,
            UpdateSourceTrigger=PropertyChanged,
            Converter={StaticResource BoolToVisConverter}}"
                Grid.RowSpan="5"
                Background="#77000000">
            <Border Background="#222"
                    BorderBrush="#666"
                    BorderThickness="1"
                    CornerRadius="8"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="250"/>
                    </Grid.RowDefinitions>
                    <Grid Name="SharePanelHeader">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Share with friends"
                               Style="{StaticResource WindowTitle}"/>
                        <Button x:Name="CloseSharePanelButton"
                                Style="{StaticResource RoundButton}"
                                Width="30"
                                Height="30"
                                Grid.Column="1"
                                Click="CloseSharePanelButton_Click">
                            <Path Data="{StaticResource CloseIcon}"
                                  Fill="#f2c480"
                                  Width="15"
                                  Height="15"
                                  Stretch="Uniform"/>
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding SelectableFriends}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Style="{StaticResource DarkCheckbox}"
                                                  IsChecked="{Binding IsSelected}"
                                                  Width="30"
                                                  Height="30"/>
                                        <TextBlock Text="{Binding User.Username}"
                                                   Margin="10"
                                                   Foreground="WhiteSmoke"
                                                   FontSize="18"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
