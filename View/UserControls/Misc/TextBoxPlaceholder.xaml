<UserControl x:Class="TCM_Launcher.View.UserControls.Misc.TextBoxPlaceholder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TCM_Launcher.View.UserControls.Misc"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="300"
             x:Name="ControlRoot">

        <Border Background="#292929"
                BorderBrush="#393939"
                BorderThickness="2"
                CornerRadius="8">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="WhiteSmoke"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
            <Grid Background="Transparent">
                <TextBlock 
                    x:Name="PlaceholderBox"
                    Text="{Binding Placeholder, ElementName=ControlRoot, FallbackValue=Placeholder}" 
                    FontSize="20"
                    FontFamily="Calibri"
                    Margin="10"
                    Foreground="#bbb"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"/>
            <TextBox x:Name="InputBox"
                     Text="{Binding Input, ElementName=ControlRoot, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="20"
                     FontFamily="Calibri"
                     Foreground="WhiteSmoke"
                     VerticalAlignment="Center"
                     Background="Transparent"
                     CaretBrush="WhiteSmoke"
                     SelectionBrush="#f2c480"
                     BorderThickness="0"
                     Height="40"
                     VerticalContentAlignment="Center"
                     Margin="6 0" TextChanged="InputBox_TextChanged">
            </TextBox>
            </Grid>
        </Border>
    
</UserControl>
