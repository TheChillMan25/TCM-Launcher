<UserControl x:Class="TCM_Launcher.View.UserControls.ProfileModView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TCM_Launcher.View.UserControls"
             mc:Ignorable="d" 
             Height="70" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#bbb"/>
            <Setter Property="Margin" Value="5 1"/>
        </Style>
    </UserControl.Resources>
    <Border BorderThickness="0 1"
            Margin="0 -1 0 0"
            BorderBrush="#444"
            Padding="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Mod.IconUrl, FallbackValue=Assets/mc_img.png}"
               Height="40" 
               Width="40"/>
                <StackPanel Grid.Column="1"
                    VerticalAlignment="Center">
                    <TextBlock Text="{Binding Mod.Name, FallbackValue=Mod name}"
                       FontSize="20"
                       Foreground="#f2c480"/>
                    <TextBlock Text="{Binding Mod.Author, FallbackValue=Author}"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Column="1"
                VerticalAlignment="Center">
                <TextBlock Text="{Binding Mod.Version, FallbackValue=Mod version}"
                   FontSize="18"
                   Foreground="WhiteSmoke"/>
                <TextBlock Text="{Binding Mod.FileName, FallbackValue=Mod filename}"/>
            </StackPanel>
            <StackPanel Grid.Column="2"
                VerticalAlignment="Center"
                HorizontalAlignment="Right">
                <Button x:Name="RemoveButton"
                Height="35"
                Width="35"
                Style="{StaticResource RoundButton}" Click="RemoveButton_Click">
                    <Path Data="{StaticResource DeleteIcon}"
                  Stroke="#f2c480"
                  StrokeThickness="2"
                  />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
