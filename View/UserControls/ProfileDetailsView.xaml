<UserControl x:Class="TCM_Launcher.View.UserControls.ProfileDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TCM_Launcher.View.UserControls"
             xmlns:converters="clr-namespace:TCM_Launcher.Core.Utils.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:InverseBooleanConverter x:Key="InverseBool"/>
    </UserControl.Resources>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="80"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Margin="5 0 10 0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Path   Data="{StaticResource ProfileIcon}"
                    Fill="#f2c480"
                    Width="60"
                    Height="60"
                    Stretch="Uniform"/>
            <Grid Grid.Column="1" Height="80">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" 
                       Content="{Binding SelectedGameProfile.ProfileName, 
                                UpdateSourceTrigger=PropertyChanged}"
                       Foreground="#f2c480"  
                       FontSize="24" 
                       FontFamily="Arial" 
                       FontWeight="Bold"/>
                <Label Grid.Row="1"
                       Content="{Binding HeaderText, 
                                UpdateSourceTrigger=PropertyChanged}" 
                       Foreground="#f2c480" 
                       FontSize="20" 
                       FontFamily="Arial"/>
                <ProgressBar    Grid.Column="1" 
                                Grid.RowSpan="2"
                                Value="{Binding DownloadProgress}" 
                                Visibility="{Binding SelectedGameProfile.Installed, 
                                        Converter={StaticResource InverseBoolToVis}}" 
                                Height="10"
                                Margin="5,0,20,0" 
                                Foreground="#f2c480" 
                                Background="#FF333333" 
                                BorderThickness="0"/>
            </Grid>
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Name="StartButton"
                        Click="StartButton_Click"
                        Margin="0 0 3 0"
                        IsEnabled="{Binding IsEnable}"
                        Style="{StaticResource ButtonWithIcon}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Path   Data="{StaticResource PlayIcon}"
                                Fill="#333"
                                Width="15"
                                Height="15"
                                Margin="0 0 5 0"
                                Stretch="Uniform"/>
                        <TextBlock Text="{Binding PlayButtonText}" 
                                   Grid.Column="1"
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Name="OptionsButton"
                        Style="{StaticResource RoundButton}"
                        Click="OptionsButton_Click"
                        IsEnabled="{Binding IsEnable}">
                    <Path   Data="{StaticResource SettingsIcon}"
                            Stroke="#f2c480"
                            StrokeThickness="2"
                            Stretch="Uniform"/>
                </Button>
                <Button Name="OtherButton" 
                        Style="{StaticResource RoundButton}" 
                        Click="OtherButton_Click"
                        IsEnabled="{Binding IsEnable}">
                    <Path   Data="{StaticResource DotsIcon}"
                            Fill="#f2c480"
                            Stretch="Uniform"/>
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource DarkContextMenu}"
                                    ItemContainerStyle="{StaticResource DarkMenuItem}">

                            <ContextMenu.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#333"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#333"/>
                            </ContextMenu.Resources>

                            <MenuItem Header="Open folder" Click="OpenFolder_Click">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource FolderIcon}" Fill="#ccc" Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <MenuItem Header="Export modpack" Click="ExportModpack_Click">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource ExportIcon}" Fill="#ccc" Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <MenuItem Header="Delete profile" Click="DeleteProfile_Click">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource DeleteIcon}" Stroke="#ccc" StrokeThickness="2" Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>

                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
