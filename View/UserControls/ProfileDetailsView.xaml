<UserControl x:Class="TCM_Launcher.View.UserControls.ProfileDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TCM_Launcher.View.UserControls"
             xmlns:converters="clr-namespace:TCM_Launcher.Core.Utils.Converters"
             xmlns:ucmisc="clr-namespace:TCM_Launcher.View.UserControls.Misc"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanConverter x:Key="InverseBool"/>
    </UserControl.Resources>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid x:Name="Header" 
              Margin="10 20" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image  Source="/Assets/mc_img.png"
                    Width="60"
                    Height="60"/>
            <Grid Grid.Column="1" Height="80">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" 
                       Content="{Binding Profile.ProfileName, 
                                FallbackValue='Profile name',
                                TargetNullValue='Profile name',
                                UpdateSourceTrigger=PropertyChanged}"
                       Foreground="#f2c480"  
                       FontSize="24" 
                       FontFamily="Arial" 
                       FontWeight="Bold"/>
                <Label Grid.Row="1"
                       Content="{Binding HeaderText, 
                                FallbackValue='Header text',
                                TargetNullValue='Header text',
                                UpdateSourceTrigger=PropertyChanged}" 
                       Foreground="WhiteSmoke" 
                       FontSize="20" 
                       FontFamily="Arial"/>
                <Grid Grid.Column="1" 
                      Grid.RowSpan="2"
                      Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding ProgressText,
                        FallbackValue=Install status,
                        TargetNullValue=Install status}"
                              Visibility="{Binding ProgressVisible, 
                                        UpdateSourceTrigger=PropertyChanged,
                                        Converter={StaticResource BoolToVis}}" 
                               FontSize="22"
                               FontFamily="Calibri"
                               Foreground="#f2c480"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="5"/>
                    <ProgressBar Grid.Row="1"
                                Value="{Binding ProgressNumber}" 
                                Visibility="{Binding ProgressVisible, 
                                        UpdateSourceTrigger=PropertyChanged,
                                        Converter={StaticResource BoolToVis}}" 
                                Height="10"
                                Foreground="#f2c480" 
                                Background="#FF333333" 
                                BorderThickness="0"/>

                </Grid>
            </Grid>
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Name="StartButton"
                        Click="StartButton_Click"
                        Margin="0 0 3 0"
                        IsEnabled="{Binding IsEnable}"
                        Style="{StaticResource ButtonWithIcon}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path   Data="{StaticResource PlayIcon}"
                                Fill="#333"
                                Width="15"
                                Height="15"
                                Margin="0 0 5 0"
                                Stretch="Uniform"/>
                        <TextBlock Text="{Binding PlayButtonText, FallbackValue=Play}" 
                                   Grid.Column="1"
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Name="OptionsButton"
                        Style="{StaticResource RoundButton}"
                        Click="OptionsButton_Click"
                        IsEnabled="{Binding IsEnable}">
                    <Path   Data="{StaticResource SettingsIcon}"
                            Stroke="#f2c480"
                            StrokeThickness="2"
                            Stretch="Uniform"/>
                </Button>
                <Button Name="OtherButton" 
                        Style="{StaticResource RoundButton}" 
                        Click="OtherButton_Click"
                        IsEnabled="{Binding IsEnable}">
                    <Path   Data="{StaticResource DotsIcon}"
                            Fill="#f2c480"
                            Stretch="Uniform"/>
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource DarkContextMenu}"
                                    ItemContainerStyle="{StaticResource DarkMenuItem}">

                            <ContextMenu.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#333"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#333"/>
                            </ContextMenu.Resources>

                            <MenuItem Header="{Binding PinText}" 
                                      Click="Pin_Click">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource PinIcon}"
                                          Fill="#ccc" 
                                          Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <MenuItem Header="Open folder" 
                                      Click="OpenFolder_Click">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource FolderIcon}"
                                          Fill="#ccc" 
                                          Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <MenuItem Header="Export modpack" 
                                      Click="ExportModpack_Click">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource ExportIcon}" 
                                          Fill="#ccc" 
                                          Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <MenuItem Header="Delete profile" 
                                      Click="DeleteProfile_Click">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource DeleteIcon}" Stroke="#ccc" StrokeThickness="2" Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>

                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1"
              VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ModsCountText,
                FallbackValue='0 mods',
                TargetNullValue='0 Mods'}"
                       Foreground="WhiteSmoke"
                       VerticalAlignment="Center"
                       FontSize="18"
                       Margin="5"/>
            <Button x:Name="BrowseContentButton"
                    Style="{StaticResource ButtonWithIcon}"
                    HorizontalAlignment="Right"
                    Grid.Column="1"
                    Margin="20 10"
                    Padding="10" 
                    Click="BrowseContentButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource CompassIcon}"
                          Fill="#333"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Margin="0 0 5 0"
                          Stretch="Uniform"/>
                    <TextBlock Text="Browse content"
                               Grid.Column="1"/>
                </Grid>
            </Button>
            <Button x:Name="ImportModpackButton"
                    Style="{StaticResource ButtonWithIcon}"
                    Grid.Column="2"
                    Margin="10"
                    Padding="10" 
                    Click="ImportModpackButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource ImportIcon}"
                          Stroke="#333"
                          StrokeThickness="2"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Margin="0 0 5 0"
                          Stretch="Uniform"/>
                    <TextBlock Text="Import modpack"
                               Grid.Column="1"/>
                </Grid>
            </Button>
            <Button x:Name="ImportModButton"
                    Style="{StaticResource RoundButton}"
                    Grid.Column="3" Click="ImportModButton_Click">
                <Button.ToolTip>
                    <ucmisc:CustomTooltip TooltipLabelText="Import mod" 
                                    TooltipContentText="Import preinstalled mod from your computer."/>
                </Button.ToolTip>
                <Path Data="{StaticResource ImportIcon}"
                      Stroke="#f2c480"
                      StrokeThickness="2"
                      Width="25"
                      Height="25"
                      Stretch="Uniform"/>
            </Button>
        </Grid>
        <Grid Name="ProfileMods"
              Grid.Row="2" 
              Margin="20 20 20 0">
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#f2c480"/>
                    <Setter Property="FontFamily" Value="Calibri"/>
                    <Setter Property="Margin" Value="5"/>
                    <Setter Property="FontSize" Value="22"/>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border Grid.ColumnSpan="3"
                    Background="#333"
                    BorderThickness="1 1 1 0"
                    BorderBrush="#444"
                    CornerRadius="10 10 0 0"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Mod"
                           Margin="10"/>
                <ComboBox x:Name="SortCombo"
                          ItemsSource="{Binding ModSortFilters}"
                          Grid.Column="1"
                          FontSize="18"
                          SelectedItem="{Binding SelectedFilter}"
                          SelectionChanged="SortCombo_SelectionChanged"/>
            </Grid>
            <TextBlock Text="Version" 
                       Grid.Column="1"
                       Margin="10"/>
            <TextBlock Text="Actions" 
                       Grid.Column="2"
                       Margin="10"/>
            <ListBox ItemsSource="{Binding ProfileMods,
                UpdateSourceTrigger=PropertyChanged}"
                     BorderBrush="#444"
                     Grid.Row="1"
                     Grid.ColumnSpan="3"
                     BorderThickness="1 0"
                     Background="#282828"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            </Grid>
    </Grid>
</UserControl>
