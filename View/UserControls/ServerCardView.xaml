<UserControl x:Class="TCM_Launcher.View.UserControls.ServerCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TCM_Launcher.View.UserControls"
             xmlns:converters="clr-namespace:TCM_Launcher.Core.Utils.Converters"
             xmlns:userControls="clr-namespace:TCM_Launcher.View.UserControls"
             mc:Ignorable="d" 
             Height="80"
             Width="230"
             MaxHeight="100"
             MaxWidth="250"
             Margin="5">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#f5f5f5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="RootGrid">
        <Border Name="Background" 
                Grid.ColumnSpan="3"
                Grid.RowSpan="3"
                Background="#333" 
                CornerRadius="10"
                Padding="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition MinHeight="30" Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="35"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ServerName" 
                           Text="{Binding Server.Name}"
                           Foreground="#f2c480"
                           FontSize="20"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ServerVersion"
                           Text="{Binding Server.MCVersion}"
                           Grid.Row="1"/>
                <TextBlock x:Name="ServerIP"
                           Text="{Binding Server.Address}"
                           TextTrimming="CharacterEllipsis"
                           Grid.Row="2">
                    <TextBlock.ToolTip>
                        <userControls:Tooltip TooltipLabelText="Server address" TooltipContentText="{Binding Server.Address}"/>
                    </TextBlock.ToolTip>
                </TextBlock>
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource DotIcon}"
                          Grid.Column="0"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Height="15"
                          Width="15"
                          Fill="{Binding Color}"/>
                    <Path Data="{StaticResource ServerIcon}"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Height="25"
                          Width="25"
                          Fill="#f5f5f5"/>

                </Grid>
                <Button Name="OptionsButton"
                        Style="{StaticResource RoundButton}"
                        HorizontalAlignment="Right"
                        Grid.Column="2"
                        Height="25"
                        Width="25" 
                        Click="OptionsButton_Click">
                    <Path   Data="{StaticResource DotsIcon}"
                            Fill="#f2c480"
                            StrokeThickness="2"
                            Height="15"
                            Width="15"
                            Stretch="Uniform"/>
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource DarkContextMenu}"
                                     ItemContainerStyle="{StaticResource DarkMenuItem}">
                            <ContextMenu.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#333"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#333"/>
                            </ContextMenu.Resources>

                            <MenuItem Header="Edit"
                                      FontSize="15"
                                      Click="Edit_Click">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource WrenchIcon}" 
                                          Fill="#ccc" 
                                          Width="15"
                                          Height="15"
                                          Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Remove"
                                      FontSize="15"
                                      Click="Remove_Click">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource DeleteIcon}"
                                          Stroke="#ccc"
                                          StrokeThickness="2"
                                          Width="15"
                                          Height="15"
                                          Stretch="Uniform"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="QuickStartButton"
                        Style="{StaticResource ButtonWithIcon}"
                        Height="30"
                        Width="45"
                        Visibility="{Binding HasBindedProfile, 
                        UpdateSourceTrigger=PropertyChanged, 
                        Converter={StaticResource BoolToVis}}"
                        Padding="5"
                        Margin="15 0 0 0"
                        Grid.ColumnSpan="2"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Grid.Row="1" Click="QuickStartButton_Click">
                    <Button.ToolTip>
                        <userControls:Tooltip TooltipLabelText="Quick launch" TooltipContentText="Quickly launch the profile thats compatible with this server."/>
                    </Button.ToolTip>

                    <Path   Data="{StaticResource PlayIcon}"
                            Fill="#333"
                            StrokeThickness="2"
                            Height="15"
                            Width="15"
                            Stretch="Uniform"/>
                </Button>
                <Button x:Name="BindProfileButton"
                        Style="{StaticResource ButtonWithIcon}"
                        Height="30"
                        Width="45"
                        Visibility="{Binding HasBindedProfile, 
                        UpdateSourceTrigger=PropertyChanged, 
                        Converter={StaticResource InverseBoolToVis}}"
                        Padding="5"
                        Margin="15 0 0 0"
                        Grid.ColumnSpan="2"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Grid.Row="1" Click="Edit_Click">
                    <Button.ToolTip>
                        <userControls:Tooltip TooltipLabelText="Bind a profile" TooltipContentText="Bind a profile so that you can quicly join this server."/>
                    </Button.ToolTip>

                    <Path   Data="{StaticResource AddIcon}"
                            Fill="#333"
                            StrokeThickness="2"
                            Height="15"
                            Width="15"
                            Stretch="Uniform"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
