<UserControl x:Class="TCM_Launcher.View.UserControls.TextBoxWithPlaceholder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TCM_Launcher.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="250">
    <Grid Background="White">
        <TextBox Name="Input" FontSize="14" VerticalContentAlignment="Center" Background="Transparent" TextChanged="Input_TextChanged"></TextBox>
        <TextBlock Name="PlaceholderText" Text="Hello World" FontSize="14" Foreground="DarkGray" Margin="5,0,0,0" VerticalAlignment="Center" Panel.ZIndex="-1" ></TextBlock>
    </Grid>
</UserControl>
