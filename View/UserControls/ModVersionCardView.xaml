<UserControl x:Class="TCM_Launcher.View.UserControls.ModVersionCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TCM_Launcher.View.UserControls"  
             xmlns:converters="clr-namespace:TCM_Launcher.Core.Utils.Converters"
             mc:Ignorable="d" 
             Height="Auto" d:DesignWidth="300">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanConverter x:Key="InverseBool"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Border Background="#333"
            CornerRadius="5"
            Margin="5"
            Padding="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ReleaseTypeTextBlock"
                       Text="{Binding ReleaseType,
                UpdateSourceTrigger=PropertyChanged,
                FallbackValue=R}"
                       Foreground="{Binding ReleaseTypeColor,
                UpdateSourceTrigger=PropertyChanged, 
                FallbackValue=Teal}"
                       FontWeight="Bold"
                       Width="30"
                       Margin="0 0 5 0"
                       TextAlignment="Center"
                       FontSize="24"/>
            <TextBlock Text="{Binding Version.Name,
                FallbackValue=VersionName}"
                       Grid.Column="1"
                       Foreground="WhiteSmoke"
                       FontSize="16"/>
            <Button x:Name="DownloadButton"
                    Style="{StaticResource RoundButton}"
                    IsEnabled="{Binding IsBindedToProfile,
                UpdateSourceTrigger=PropertyChanged,
                Converter={StaticResource InverseBool}}"
                    Background="Transparent"
                    Grid.Column="2"
                    Height="35"
                    Width="35" Click="DownloadButton_Click">
                <Grid>
                    <Path Data="{StaticResource DownloadIcon}"
                          Visibility="{Binding IsBindedToProfile,
                        UpdateSourceTrigger=PropertyChanged,
                        Converter={StaticResource InverseBoolToVis}}"
                          Height="20"
                          Width="20"
                          Stretch="Uniform"
                          Fill="#f2c480"/>
                    <Path Data="{StaticResource TickIcon}"
                          Visibility="{Binding IsBindedToProfile,
                        UpdateSourceTrigger=PropertyChanged,
                        Converter={StaticResource BoolToVis}}"
                          Height="20"
                          Width="20"
                          Stretch="Uniform"
                          Stroke="#f2c480"
                          StrokeThickness="2"/>
                </Grid>
            </Button>
        </Grid>
    </Border>

</UserControl>
