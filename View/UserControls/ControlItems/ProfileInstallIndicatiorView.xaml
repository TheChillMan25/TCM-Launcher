<UserControl x:Class="TCM_Launcher.View.UserControls.ControlItems.ProfileInstallIndicatiorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TCM_Launcher.View.UserControls.ControlItems"
             mc:Ignorable="d" 
             Height="150" Width="350">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
    </UserControl.Resources>
    <Border Background="#333"
            CornerRadius="8"
            BorderBrush="#666"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Name="Header">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="#171717"
                        CornerRadius="8 8 0 0"
                        Grid.ColumnSpan="2"/>
                <TextBlock Text="{Binding ProfileName,
                    UpdateSourceTrigger=PropertyChanged,
                    FallbackValue='ProfileName',
                    TargetNullValue='ProfileName'}"
                           Foreground="#f2c480"
                           FontSize="24"/>
                <Button x:Name="CloseButton"
                        Style="{StaticResource RoundButton}"
                        Width="30"
                        Height="30"
                        Grid.Column="1"
                        HorizontalAlignment="Right" Click="CloseButton_Click">
                    <Path Data="{StaticResource CloseIcon}"
                          Fill="#f2c480"
                          Width="15"
                          Height="15"
                          Stretch="Uniform"/>
                </Button>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Status,
                    UpdateSourceTrigger=PropertyChanged,
                    FallbackValue='Status',
                    TargetNullValue='Status'}"
                           Foreground="WhiteSmoke"/>
                <ProgressBar Value="{Binding Progress,
                    UpdateSourceTrigger=PropertyChanged,
                    FallbackValue=1,
                    TargetNullValue=1}"
                             Grid.Row="1"
                             Height="10"
                             Background="#333"
                             Foreground="#f2c480"
                             BorderThickness="0"
                             Maximum="{Binding MaxRemainTime}"
                             Minimum="0"
                             Margin="10"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
