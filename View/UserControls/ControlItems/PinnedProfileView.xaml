<UserControl x:Class="TCM_Launcher.View.UserControls.ControlItems.PinnedProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TCM_Launcher.View.UserControls.ControlItems"
             mc:Ignorable="d" 
             d:DesignHeight="75" d:DesignWidth="200">
    <Border Background="#333"
            Margin="10"
            CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="QuickPlayButton"
            Style="{StaticResource ButtonWithIcon}"
            IsEnabled="{Binding PlayEnabled, UpdateSourceTrigger=PropertyChanged}"
            Padding="5"
            Width="40"
            Height="40"
            Margin="5" Click="QuickPlayButton_Click">
                <Path Data="{StaticResource PlayIcon}"
              Fill="#333"
              Height="20"
              Width="20"
              Stretch="Uniform"/>
            </Button>
            <TextBlock Text="{Binding Profile.ProfileName,
                FallbackValue='Profile name',
                TargetNullValue='Profile name'}"
                        Foreground="WhiteSmoke"
                       TextTrimming="CharacterEllipsis"
                        FontSize="18"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="5"/>
            <Button x:Name="UnpinButton"
            Grid.Column="2"
            Height="30"
            Width="30"
            Style="{StaticResource RoundButton}" Click="UnpinButton_Click">
                <Path Data="{StaticResource PinIcon}"
              Fill="#f2c480"
              Height="15"
              Width="15"
              Stretch="Uniform"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
