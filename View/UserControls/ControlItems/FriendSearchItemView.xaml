<UserControl x:Class="TCM_Launcher.View.UserControls.ControlItems.FriendSearchItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TCM_Launcher.View.UserControls.ControlItems"
             mc:Ignorable="d" 
             Height="80" 
             d:DesignWidth="300">
    <Border Background="#222"
        Margin="10"
        Padding="10 5"
        CornerRadius="8">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Username,
            FallbackValue=User,
            TargetNullValue=User}"
                   FontSize="20"
                   Foreground="WhiteSmoke"
                   VerticalAlignment="Center"/>
            <Button x:Name="AddFriendButton"
                    Style="{StaticResource RoundButton}"
                    Width="30"
                    Height="30"
                    Grid.Column="1"
                    Click="AddFriendButton_Click">
                <Path Data="{StaticResource AddIcon}"
                  Fill="#f2c480"
                  Width="15"
                  Height="15"
                  Stretch="Uniform"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
