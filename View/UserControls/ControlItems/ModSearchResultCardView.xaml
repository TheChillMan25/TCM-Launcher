<UserControl x:Class="TCM_Launcher.View.UserControls.ControlItems.ModSearchResultCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TCM_Launcher.View.UserControls.ControlItems"
             mc:Ignorable="d" 
             Height="150" d:DesignWidth="700">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="WhiteSmoke"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Calibri"/>
        </Style>
    </UserControl.Resources>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <Image Source="{Binding Mod.IconUrl, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Mod.Title, 
                        UpdateSourceTrigger=PropertyChanged, 
                        FallbackValue=ModName}"
                               Foreground="#f2c480"/>
                    <TextBlock Text="by"
                               Grid.Column="1" 
                               Margin="5 0"
                               FontSize="14"/>
                    <TextBlock Text="{Binding Mod.Author, 
                        UpdateSourceTrigger=PropertyChanged, 
                        FallbackValue=Author}" 
                               Grid.Column="2"
                               FontSize="14"/>
                </Grid>
                <TextBlock Text="{Binding Mod.Summary,
                    UpdateSourceTrigger=PropertyChanged,
                    FallbackValue=Summary}"
                           Grid.Row="1"/>
            <ItemsControl ItemsSource="{Binding Mod.Categories}"
                              Grid.Row="2"
                              VerticalAlignment="Center"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#444"
                            BorderBrush="#555"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="2 5"
                            Padding="10 5">
                            <TextBlock Text="{Binding}"
                                   Foreground="#bbb"
                                   FontSize="16"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
        </Grid>
</UserControl>
