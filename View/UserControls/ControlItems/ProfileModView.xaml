<UserControl x:Class="TCM_Launcher.View.UserControls.ControlItems.ProfileModView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TCM_Launcher.View.UserControls.ControlItems"
             xmlns:misc="clr-namespace:TCM_Launcher.View.UserControls.Misc"
             mc:Ignorable="d" 
             Height="70" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#bbb"/>
            <Setter Property="Margin" Value="5 1"/>
        </Style>
    </UserControl.Resources>
    <Border Padding="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Image Source="{Binding IconUrl, 
                        FallbackValue='pack://application:,,,/Assets/mc_img.png', 
                        TargetNullValue='pack://application:,,,/Assets/mc_img.png'}"
                       Height="40" 
                       Width="40"/>
                <StackPanel Grid.Column="1"
                    VerticalAlignment="Center">
                    <TextBlock Text="{Binding Mod.Name, FallbackValue=Mod name}"
                       FontSize="20"
                       Foreground="#f2c480"/>
                    <TextBlock Text="{Binding Mod.Author, FallbackValue=Author}"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Column="1"
                VerticalAlignment="Center">
                <TextBlock Text="{Binding Mod.Version, FallbackValue=Mod version}"
                   FontSize="18"
                   Foreground="WhiteSmoke"/>
                <TextBlock Text="{Binding Mod.FileName, FallbackValue=Mod filename}"/>
            </StackPanel>
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                VerticalAlignment="Center"
                HorizontalAlignment="Right">
                <Button x:Name="ImportFileButton"
                        Visibility="{Binding MissingJar,
                    UpdateSourceTrigger=PropertyChanged,
                    Converter={StaticResource BoolToVis},
                    FallbackValue=Visible,
                    TargetNullValue=Visible}"
                        Height="35"
                        Width="35"
                        Style="{StaticResource RoundButton}" Click="ImportFileButton_Click">
                    <Button.ToolTip>
                        <misc:CustomTooltip TooltipLabelText="Import file" 
                                            TooltipContentText="Import missing jar file for this mod."/>
                    </Button.ToolTip>
                    <Path Data="{StaticResource ImportIcon}"
                          Stroke="#f2c480"
                          StrokeThickness="2"
                  />
                </Button>
                <Button x:Name="RemoveButton"
                        Height="35"
                        Width="35"
                        Style="{StaticResource RoundButton}" Click="RemoveButton_Click">
                    <Path Data="{StaticResource DeleteIcon}"
                          Stroke="#f2c480"
                          StrokeThickness="2"
                      />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
