<UserControl x:Class="TCM_Launcher.View.UserControls.ControlItems.NotificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TCM_Launcher.View.UserControls.ControlItems"
             mc:Ignorable="d" 
             d:DesignHeight="80" d:DesignWidth="500"
             MaxWidth="600">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="WhiteSmoke"/>
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </UserControl.Resources>
    <Border Background="#222"
            Margin="10"
            Padding="10 5"
            CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Sender,
                FallbackValue='Sender',
                TargetNullValue='Sender'}"
                       Foreground="#f2c480"
                       FontWeight="Bold"/>
            <TextBlock Text="{Binding NotificationText,
                FallbackValue='Notification text',
                TargetNullValue='Notification text'}"
                       Grid.Column="1"/>
            <TextBlock Text="{Binding Date,
                FallbackValue='mm.dd.yyyy hh:mm',
                TargetNullValue='mm.dd.yyyy hh:mm'}"
                       Grid.Column="2"/>
            <Button x:Name="AcceptButton"
                    Style="{StaticResource RoundButton}"
                    Width="30"
                    Height="30"
                    Grid.Column="3"
                    Click="AcceptButton_Click">
                <Path Data="{StaticResource TickIcon}"
                      Stroke="#f2c480"
                      StrokeThickness="2"
                      Width="15"
                      Height="15"
                      Stretch="Uniform"/>
            </Button>
            <Button x:Name="RejectButton"
                    Style="{StaticResource RoundButton}"
                    Width="30"
                    Height="30"
                    Grid.Column="4" Click="RejectButton_Click">
                <Path Data="{StaticResource CloseIcon}"
                      Fill="#f2c480"
                      Width="15"
                      Height="15"
                      Stretch="Uniform"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
