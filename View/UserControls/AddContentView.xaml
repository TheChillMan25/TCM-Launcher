<UserControl x:Class="TCM_Launcher.View.UserControls.AddContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TCM_Launcher.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid Name="Header">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Image Source="/Assets/mc_img.png"
                   Margin="10"/>
            <TextBlock Text="{Binding Profile.ProfileName, FallbackValue=Profile name}"
                       FontSize="24"
                       Grid.Column="1"
                       Foreground="#f2c480"
                       FontFamily="Calibri"
                       Margin="10 0"
                       VerticalAlignment="Center"/>
            <Button x:Name="CloseButton"
                    Grid.Column="2"
                    Height="30"
                    Width="30"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Style="{StaticResource RoundButton}" Click="CloseButton_Click">
                <Path Data="{StaticResource CloseIcon}"
                      Fill="WhiteSmoke"/>
            </Button>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Path Data="{StaticResource MagnifyingIcon}"
                  VerticalAlignment="Center"
                                      Margin="10"
                  Height="30"
                  Width="30"
                  Fill="#f2c480"
                  Stretch="Uniform"/>
            <local:TextBoxPlaceholder Grid.Column="1"
                                      Height="40"
                                      Margin="10"
                                      Placeholder="Search mods"
                                      Input="{Binding SearchText}"/>
        </Grid>
        <ListBox ItemsSource="{Binding SearchResult}"
                 SelectedItem="{Binding SelectedSearchResult,
            UpdateSourceTrigger=PropertyChanged,
            Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource SearchResultListBoxItemStyle}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Grid.Row="2"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="5">
        </ListBox>
    </Grid>
</UserControl>
