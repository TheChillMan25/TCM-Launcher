<UserControl x:Class="TCM_Launcher.View.UserControls.SearchedModDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TCM_Launcher.View.UserControls"
             xmlns:md="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf" 
             xmlns:converters="clr-namespace:TCM_Launcher.Core.Utils.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:DownloadCountConverter x:Key="DownloadConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="10 5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="Foreground" Value="WhiteSmoke"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Source="{Binding Details.IconUrl,
                UpdateSourceTrigger=PropertyChanged, 
                FallbackValue='pack://application:,,,/Assets/mc_img.png', 
                TargetNullValue='pack://application:,,,/Assets/mc_img.png'}"
                   Height="120"
                   Width="120"
                   Margin="10"/>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="ModNameTextBlock"
                           Text="{Binding Details.Title, 
                    UpdateSourceTrigger=PropertyChanged,
                    FallbackValue=Title}"
                           Foreground="#f2c480"
                           FontSize="28"/>
                <TextBlock x:Name="ModSummaryTextBlock"
                           Text="{Binding Details.Summary, 
                    UpdateSourceTrigger=PropertyChanged,
                    FallbackValue=Summary}"
                           Grid.Row="1"/>
                <StackPanel Orientation="Horizontal"
                            Grid.Row="2">
                    <Grid VerticalAlignment="Center"
                          Margin="10 5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Path Data="{StaticResource DownloadIcon}"
                              Height="30"
                              Width="30"
                              Stretch="Uniform"
                              Fill="#f2c480"/>
                        <TextBlock Text="{Binding Details.DownloadCount,
                            UpdateSourceTrigger=PropertyChanged,
                            FallbackValue=123,
                            Converter={StaticResource DownloadConverter}}"
                                   Grid.Column="1"/>
                    </Grid>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Button x:Name="BackButton"
                        HorizontalAlignment="Right"
                        Height="30"
                        Width="30"
                        Style="{StaticResource RoundButton}" Click="BackButton_Click">
                    <Path Data="{StaticResource BackIcon}"
                          Height="15"
                          Width="15"
                          Stretch="Uniform"
                          Fill="WhiteSmoke"/>
                </Button>
                <Button x:Name="InstallLatestButton"
                        Style="{StaticResource ButtonWithIcon}"
                        IsEnabled="{Binding CanInstallLatest,
                    UpdateSourceTrigger=PropertyChanged}"
                        Grid.Row="1"
                        Grid.RowSpan="2"
                        Margin="10"
                        HorizontalAlignment="Center"
                        Click="InstallLatestButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Path Data="{StaticResource AddIcon}"
                              Visibility="{Binding IsLatestBindedToProfile,
                            UpdateSourceTrigger=PropertyChanged, 
                            Converter={StaticResource InverseBoolToVis}}"
                              Height="15"
                              Width="15"
                              Stretch="Uniform"
                              Fill="#333"/>
                        <Path Data="{StaticResource TickIcon}"
                              Visibility="{Binding IsLatestBindedToProfile,
                            UpdateSourceTrigger=PropertyChanged, 
                            Converter={StaticResource BoolToVis}}"
                              Height="15"
                              Width="15"
                              Stretch="Uniform"
                              Stroke="#333"
                              StrokeThickness="2"/>
                        <TextBlock Text="{Binding InstallText,
                            UpdateSourceTrigger=PropertyChanged,
                            FallbackValue=Install}"
                               Grid.Column="1"
                               Foreground="#333"/>

                    </Grid>
                </Button>

            </Grid>
        </Grid>
        <md:MarkdownViewer Name="Description"
                           Markdown="{Binding Details.Description}"
                           Grid.Row="1"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           PreviewMouseWheel="MarkdownViewer_PreviewMouseWheel"
                           Foreground="WhiteSmoke"
                           Margin="10">
            <md:MarkdownViewer.CommandBindings>
                <CommandBinding Command="{x:Static md:Commands.Hyperlink}" Executed="OpenHyperlink" />
            </md:MarkdownViewer.CommandBindings>
            <md:MarkdownViewer.Resources>
                <Style TargetType="{x:Type Paragraph}">
                    <Setter Property="Foreground" Value="WhiteSmoke" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                </Style>
                <Style TargetType="{x:Type ListItem}">
                    <Setter Property="Foreground" Value="WhiteSmoke" />
                </Style>
                <Style x:Key="{x:Static md:Styles.Heading1StyleKey}" TargetType="{x:Type Paragraph}">
                    <Setter Property="Foreground" Value="#FFDF7E" />
                    <Setter Property="FontSize" Value="22" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Margin" Value="0,12,0,6" />
                </Style>
                <Style x:Key="{x:Static md:Styles.Heading2StyleKey}" TargetType="{x:Type Paragraph}">
                    <Setter Property="Foreground" Value="WhiteSmoke" />
                    <Setter Property="FontSize" Value="18" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Margin" Value="0,10,0,4" />
                </Style>
                <Style x:Key="{x:Static md:Styles.Heading3StyleKey}" TargetType="{x:Type Paragraph}">
                    <Setter Property="Foreground" Value="LightGray" />
                    <Setter Property="FontSize" Value="15" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Margin" Value="0,8,0,4" />
                </Style>
            </md:MarkdownViewer.Resources>
        </md:MarkdownViewer>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Grid.Column="1"
                      Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Versions}"
                 Background="Transparent"/>
        </ScrollViewer>
    </Grid>
</UserControl>
